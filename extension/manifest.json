{
  "manifest_version": 3,
  "name": "MindMesh Clipper",
  "version": "0.1.0",
  "description": "One-click save the current page to your MindMesh knowledge base.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to MindMesh"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
