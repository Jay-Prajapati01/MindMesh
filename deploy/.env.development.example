# =============================================================================
# MindMesh Local Development Environment Configuration
# =============================================================================
# COPY THIS FILE TO backend/.env.development AND frontend/.env.development
# DO NOT COMMIT .env.development TO VERSION CONTROL!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=MindMesh
ENVIRONMENT=development
LOG_LEVEL=DEBUG
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATA_DIR=/app/data

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Not required in development (auth is disabled when ENVIRONMENT != production)
API_KEY=

# Rate limiting (disabled in development by default)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=60
TRUST_PROXY=false
SSRF_BLOCK_PRIVATE=true

# Request body limits
MAX_JSON_BODY_SIZE=10485760
MAX_MULTIPART_BODY_SIZE=220200960

# Concurrency
MAX_CONCURRENT_HEAVY_TASKS=2

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
# Local Docker container name
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=mindmesh

# -----------------------------------------------------------------------------
# Ollama LLM Server
# -----------------------------------------------------------------------------
# Local Docker container name
OLLAMA_URL=http://ollama:11434

# Models (CPU-friendly defaults)
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# Ingestion & Retrieval
# -----------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CHAT_MIN_SCORE=0.3

# -----------------------------------------------------------------------------
# Security Hardening (relaxed for development)
# -----------------------------------------------------------------------------
MAX_JSON_BODY_SIZE=10485760
MAX_MULTIPART_BODY_SIZE=220200960
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=60
TRUST_PROXY=false
SSRF_BLOCK_PRIVATE=true
MAX_CONCURRENT_HEAVY_TASKS=2
MAX_PDF_PAGES=500
ZIP_MAX_UNCOMPRESSED_BYTES=524288000
ZIP_MAX_RATIO=200
FETCH_MAX_BYTES=20971520
FETCH_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE=209715200

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Local API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Supabase (public keys - same as production)
NEXT_PUBLIC_SUPABASE_URL=https://hndfemyenbpeuegbxrzp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhuZGZlbXllbmJwZXVlZ2J4cnpwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyOTcyNDAsImV4cCI6MjEwNjg3MzI0MH0.nhO4h1B1WdTaIyS7EN7-UyF6sXd8r6ZPiFJN5jp8LOE

# -----------------------------------------------------------------------------
# Optional: Instagram (for private content access)
# -----------------------------------------------------------------------------
# IG_USERNAME=your_instagram_username
# IG_PASSWORD=your_instagram_password

# -----------------------------------------------------------------------------
# Crawl4AI
# -----------------------------------------------------------------------------
CRAWL4AI_HEADLESS=true
CRAWL4AI_CACHE_MODE=bypass

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=209715200