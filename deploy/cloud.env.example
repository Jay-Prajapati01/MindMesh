# Server/Modal Secret only. Copy to deploy/.env.modal, then fill real values privately.
ENVIRONMENT=production
MINDMESH_EXECUTION_MODE=modal
MODAL_APP_NAME=mindmesh-workers
MODAL_ENVIRONMENT=main
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase pooler URL, percent-encode password characters, append ?sslmode=require
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=mindmesh-private
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mindmesh_bge_m3_v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
CORS_ORIGINS=https://your-frontend-domain.example
SSRF_BLOCK_PRIVATE=true
# Optional, server-side only:+# IG_USERNAME=
# IG_PASSWORD=
# QWEN_MODEL=Qwen/Qwen3-8B
# WHISPER_MODEL=large-v3-turbo
