# MindMesh Caddyfile for Production HTTPS
# Replace YOUR_DOMAIN.COM with your actual domain
# Caddy will automatically obtain and renew TLS certificates via Let's Encrypt

{
    # Global options
    admin off
    # Disable HTTP/3 if not needed (uncomment if issues)
    # http3 off
}

# HTTP -> HTTPS redirect
http://YOUR_DOMAIN.COM {
    redir https://{host}{uri} permanent
}

# Main HTTPS site
https://YOUR_DOMAIN.COM {
    # Security headers
    header {
        # HSTS - enable after confirming HTTPS works
        # Strict-Transport-Security max-age=31536000
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
        # Remove server header
        -Server
    }

    # Reverse proxy to frontend (Next.js)
    @frontend {
        not path /api/*
        not path /health
        not path /_next/*
        not path /static/*
    }
    reverse_proxy @frontend frontend:3000 {
        flush_interval -1
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }

    # Reverse proxy to backend (FastAPI) for API routes
    @api {
        path /api/*
    }
    reverse_proxy @api backend:8000 {
        flush_interval -1
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }

    # Health check endpoint (public)
    handle /health {
        reverse_proxy backend:8000
    }

    # Next.js static assets - serve directly for performance
    handle /_next/static/* {
        reverse_proxy frontend:3000
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle /_next/image* {
        reverse_proxy frontend:3000
    }

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
            roll_local_time
        }
        format json
    }
}

# Optional: API subdomain (if you prefer api.YOUR_DOMAIN.COM)
# https://api.YOUR_DOMAIN.COM {
#     header {
#         X-Frame-Options "DENY"
#         X-Content-Type-Options "nosniff"
#         Referrer-Policy "strict-origin-when-cross-origin"
#     }
