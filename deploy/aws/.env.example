# Public build-time settings. These are safe to expose to a browser.
MINDMESH_DOMAIN=mindmesh.example.com
ACME_EMAIL=admin@mindmesh.example.com
NEXT_PUBLIC_API_URL=https://mindmesh.example.com/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Image naming/versioning. Set immutable image tags for rollback.
IMAGE_TAG=local
FRONTEND_IMAGE=mindmesh-frontend
API_IMAGE=mindmesh-api
WORKER_IMAGE=mindmesh-worker

# Shared application runtime: AWS uses durable PostgreSQL jobs and poll-mode workers.
ENVIRONMENT=production
MINDMESH_EXECUTION_MODE=cloud
JOB_BACKEND=postgres
WORKER_PROCESS=true
# Poll-mode workers query queued Postgres jobs at this interval. Lower values reduce latency but add DB load.
WORKER_POLL_SECONDS=10
AUTH_ENABLED=true
CORS_ORIGINS=https://mindmesh.example.com
TRUST_PROXY=true
SSRF_BLOCK_PRIVATE=true
RATE_LIMIT_ENABLED=true

# Server-side only: inject these from AWS Secrets Manager at deployment time; never commit values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=secret
SUPABASE_DB_URL=postgresql://...sslmode=require
SUPABASE_STORAGE_BUCKET=mindmesh-private
QDRANT_URL=https://YOUR-QDRANT-CLOUD
QDRANT_API_KEY=secret
QDRANT_COLLECTION=mindmesh_gemini_v1
LLM_PROVIDER=groq
GROQ_API_KEY=secret
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=secret
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
