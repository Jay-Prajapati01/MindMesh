# =============================================================================
# MindMesh Production Environment Configuration
# =============================================================================
# COPY THIS FILE TO .env.production AND FILL IN YOUR VALUES
# NEVER COMMIT .env.production TO VERSION CONTROL!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=MindMesh
ENVIRONMENT=production
LOG_LEVEL=INFO
API_PREFIX=/api

# CORS - Set to your production domain(s), comma-separated
# Example: CORS_ORIGINS=https://mindmesh.example.com,https://api.mindmesh.example.com
CORS_ORIGINS=https://YOUR_DOMAIN.COM

# Data directory (persisted via Docker volume)
DATA_DIR=/app/data

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a strong random key: openssl rand -hex 32
# Required in production for mutating endpoints (POST, DELETE, etc.)
API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=60

# Trust proxy headers (set to true when behind Caddy/nginx)
TRUST_PROXY=true

# SSRF protection for outbound fetches
SSRF_BLOCK_PRIVATE=true

# Request body limits
MAX_JSON_BODY_SIZE=10485760
MAX_MULTIPART_BODY_SIZE=220200960

# Concurrency
MAX_CONCURRENT_HEAVY_TASKS=2

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
# Internal Docker network hostname - DO NOT CHANGE
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=mindmesh

# -----------------------------------------------------------------------------
# Ollama LLM Server
# -----------------------------------------------------------------------------
# Internal Docker network hostname - DO NOT CHANGE
OLLAMA_URL=http://ollama:11434

# Models (CPU-friendly defaults for Google Cloud e2-standard-4 or similar)
# qwen2.5:3b = ~2GB RAM, fast CPU inference
# nomic-embed-text = ~300MB RAM, fast embeddings
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Alternative high-quality models (require more RAM):
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# Ingestion & Retrieval
# -----------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CHAT_MIN_SCORE=0.3

# -----------------------------------------------------------------------------
# Security Hardening
# -----------------------------------------------------------------------------
MAX_JSON_BODY_SIZE=10485760
MAX_MULTIPART_BODY_SIZE=220200960
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=60
TRUST_PROXY=true
SSRF_BLOCK_PRIVATE=true
MAX_CONCURRENT_HEAVY_TASKS=2
MAX_PDF_PAGES=500
ZIP_MAX_UNCOMPRESSED_BYTES=524288000
ZIP_MAX_RATIO=200
FETCH_MAX_BYTES=20971520
FETCH_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE=209715200

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Public API URL (used by browser - must be HTTPS in production)
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN.COM/api

# Supabase (public keys - safe to commit)
NEXT_PUBLIC_SUPABASE_URL=https://hndfemyenbpeuegbxrzp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhuZGZlbXllbmJwZXVlZ2J4cnpwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyOTcyNDAsImV4cCI6MjEwNjg3MzI0MH0.nhO4h1B1WdTaIyS7EN7-UyF6sXd8r6ZPiFJN5jp8LOE

# -----------------------------------------------------------------------------
# Optional: Instagram (for private content access)
# -----------------------------------------------------------------------------
# IG_USERNAME=your_instagram_username
# IG_PASSWORD=your_instagram_password

# -----------------------------------------------------------------------------
# Crawl4AI
# -----------------------------------------------------------------------------
CRAWL4AI_HEADLESS=true
CRAWL4AI_CACHE_MODE=bypass

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=209715200