# MindMesh Google Cloud backend configuration (Cloud Run services + job).
# Copy to a local .env for reference only — in production every *_KEY,
# *_SECRET and *_URL-with-credentials below lives in Google Secret Manager
# and is mounted via valueFrom.secretKeyRef (see *.yaml in this folder).
# NOTHING here goes into NEXT_PUBLIC_* frontend variables.

ENVIRONMENT=production
MINDMESH_EXECUTION_MODE=cloud
AUTH_ENABLED=true

# Job lifecycle store: gcp = Postgres rows + Cloud Tasks + Cloud Run Jobs.
# (postgres = rows + poll-mode worker, no Tasks; redis = legacy/Modal.)
JOB_BACKEND=gcp

# AI: chat/summaries + transcription via Groq, embeddings via Gemini.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Embeddings: one vector per chunk, 768-dim Matryoshka truncation.
# Re-embed into a NEW collection; never mix with Ollama/BGE vectors.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Supabase: database, auth, private file storage.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_key
SUPABASE_DB_URL=your_tls_database_url
SUPABASE_STORAGE_BUCKET=mindmesh-private

# Qdrant Cloud.
QDRANT_URL=https://YOUR-CLUSTER
QDRANT_API_KEY=your_qdrant_key
QDRANT_COLLECTION=mindmesh_gemini_v1

# Google Cloud dispatch.
GCP_PROJECT_ID=your-project-id
GCP_REGION=your-region
CLOUD_TASKS_QUEUE=mindmesh-jobs
CLOUD_TASKS_DISPATCHER_URL=https://mindmesh-dispatcher-XXXX-YOUR-REGION.run.app
CLOUD_TASKS_SERVICE_ACCOUNT=mindmesh-tasks@YOUR-PROJECT-ID.iam.gserviceaccount.com
CLOUD_TASKS_DISPATCH_SECRET=generate_a_long_random_secret
CLOUD_RUN_JOB_NAME=mindmesh-worker

# Security.
CORS_ORIGINS=https://yourdomain.com
SSRF_BLOCK_PRIVATE=true
RATE_LIMIT_ENABLED=true

# Frontend (Netlify) public variables — safe to expose:
# NEXT_PUBLIC_API_URL=https://mindmesh-api-XXXX-YOUR-REGION.run.app
# NEXT_PUBLIC_EXECUTION_MODE=cloud
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
